# ==========================================
# DOCUMENT MANAGEMENT SYSTEM - ENVIRONMENT
# ==========================================
# Copy this file to .env and update values

# Application Settings
# --------------------
FLASK_ENV=production
DEBUG=false
SECRET_KEY=your-secret-key-here-change-in-production
APP_PORT=5000

# Database
# --------
DATABASE_URL=sqlite:///data/db/services.db
# For PostgreSQL: postgresql://user:password@localhost:5432/dms
# For MySQL: mysql://user:password@localhost:3306/dms

# SMTP Email Settings (Optional)
# -------------------------------
ENABLE_EMAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@dms.local
ADMIN_EMAIL=admin@dms.local

# Cache Settings
# --------------
CACHE_TYPE=simple
# Options: simple, redis, memcached
# For Redis: redis://localhost:6379/0
REDIS_PORT=6379

# Security Settings
# -----------------
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600
MAX_CONTENT_LENGTH=16777216

# Feature Flags
# -------------
ENABLE_WEBHOOKS=false
ENABLE_API_DOCS=true
ENABLE_METRICS=false

# API Settings
# ------------
API_VERSION=v1
API_RATE_LIMIT=100/hour
API_KEY_REQUIRED=false

# Logging
# -------
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Nginx Settings (if using nginx profile)
# ----------------------------------------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Performance
# -----------
WORKERS=4
THREADS=2
WORKER_TIMEOUT=60

# Development Only
# ----------------
# FLASK_ENV=development
# DEBUG=true
# RELOAD=true
