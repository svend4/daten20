# Production Environment Configuration
# Copy this file to .env and update with actual values
# NEVER commit .env file to version control!

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================

APP_NAME=daten20
APP_ENV=production
APP_DEBUG=false
APP_VERSION=4.2.0

# Secret key for Flask (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# JWT secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=change-this-to-a-different-secure-random-string

# CSRF protection key (generate with: python -c "import secrets; print(secrets.token_hex(16))")
CSRF_SECRET_KEY=change-this-csrf-key-in-production

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================

# DO NOT bind to 0.0.0.0 in production! Use reverse proxy (nginx/Apache)
# Bind to localhost only and use reverse proxy
SERVER_HOST=127.0.0.1
SERVER_PORT=5000

# Workers for production (2-4 x number of CPU cores)
SERVER_WORKERS=4
SERVER_THREADS=2
SERVER_TIMEOUT=120

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# Production database (PostgreSQL recommended)
DATABASE_URL=postgresql://user:password@localhost:5432/daten20_prod
# Alternative: MySQL
# DATABASE_URL=mysql://user:password@localhost:3306/daten20_prod

# Database pool settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# SQLite (not recommended for production)
# SQLITE_DB_PATH=/var/lib/daten20/daten20.db

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================

REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_SSL=true
REDIS_MAX_CONNECTIONS=50

# ==============================================================================
# SECURITY SETTINGS
# ==============================================================================

# Session configuration
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME=3600

# HTTPS enforcement
PREFERRED_URL_SCHEME=https
SESSION_COOKIE_SECURE=true

# CORS settings
CORS_ORIGINS=https://yourdomain.com,https://api.yourdomain.com
CORS_ALLOW_CREDENTIALS=true

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URL=redis://localhost:6379/1
RATE_LIMIT_DEFAULT=100/hour
RATE_LIMIT_STRICT=true

# ==============================================================================
# API KEYS (External Services)
# ==============================================================================

# OpenAI API (if using)
OPENAI_API_KEY=sk-your-openai-api-key-here

# AWS credentials (if using S3)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1

# Google Cloud (if using)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ==============================================================================
# EMAIL CONFIGURATION
# ==============================================================================

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=noreply@yourdomain.com

# ==============================================================================
# MONITORING & LOGGING
# ==============================================================================

# Sentry for error tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Logging level
LOG_LEVEL=INFO
LOG_FILE=/var/log/daten20/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# Prometheus metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# ==============================================================================
# BACKUP CONFIGURATION
# ==============================================================================

BACKUP_ENABLED=true
BACKUP_DIRECTORY=/var/backups/daten20
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key-here
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_OFFSITE_ENABLED=true
BACKUP_S3_BUCKET=your-backup-bucket

# ==============================================================================
# PERFORMANCE SETTINGS
# ==============================================================================

# Cache settings
CACHE_TYPE=redis
CACHE_REDIS_URL=redis://localhost:6379/2
CACHE_DEFAULT_TIMEOUT=300

# File upload limits
MAX_CONTENT_LENGTH=104857600
UPLOAD_FOLDER=/var/lib/daten20/uploads

# ==============================================================================
# AI/ML SETTINGS
# ==============================================================================

# Model paths
SPACY_MODEL=en_core_web_lg
ML_MODEL_PATH=/var/lib/daten20/models

# Performance settings
ML_USE_GPU=false
ML_WORKERS=2
ML_BATCH_SIZE=32

# Advanced AI modules
CONSCIOUSNESS_ENABLED=true
AI_SAFETY_ENABLED=true
EXPLAINABLE_AI_ENABLED=true

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================

FEATURE_QUANTUM_ML=false
FEATURE_BCI=false
FEATURE_NEUROSYMBOLIC=true
FEATURE_CONTINUAL_LEARNING=true

# ==============================================================================
# ADMIN SETTINGS
# ==============================================================================

ADMIN_EMAIL=admin@yourdomain.com
ADMIN_NAME=System Administrator

# First admin user (created on first run)
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_EMAIL=admin@yourdomain.com
FIRST_ADMIN_PASSWORD=change-this-immediately

# ==============================================================================
# SSL/TLS CONFIGURATION
# ==============================================================================

SSL_CERT_PATH=/etc/ssl/certs/yourdomain.crt
SSL_KEY_PATH=/etc/ssl/private/yourdomain.key
SSL_CA_BUNDLE=/etc/ssl/certs/ca-bundle.crt

# ==============================================================================
# COMPLIANCE
# ==============================================================================

GDPR_ENABLED=true
HIPAA_ENABLED=false
DATA_RETENTION_DAYS=2555
PII_ANONYMIZATION=true

# ==============================================================================
# DEPLOYMENT NOTES
# ==============================================================================

# 1. Generate all secret keys before deployment
# 2. Use PostgreSQL or MySQL in production (not SQLite)
# 3. Setup reverse proxy (nginx/Apache) - DO NOT expose Flask directly
# 4. Enable HTTPS/TLS
# 5. Configure firewall rules
# 6. Setup automated backups
# 7. Enable monitoring (Sentry, Prometheus)
# 8. Configure email for notifications
# 9. Review and adjust rate limits
# 10. Test disaster recovery procedures
