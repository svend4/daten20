{
  "name": "dms-mobile",
  "version": "1.0.0",
  "description": "Document Management System - Mobile App",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "detox test",
    "lint": "eslint src/**/*.{js,jsx,ts,tsx}",
    "format": "prettier --write src/**/*.{js,jsx,ts,tsx,json}",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace DMS.xcworkspace -scheme DMS -configuration Release"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.72.0",
    "@react-navigation/native": "^6.1.7",
    "@react-navigation/stack": "^6.3.17",
    "@react-navigation/bottom-tabs": "^6.5.8",
    "@react-navigation/drawer": "^6.6.3",
    "@reduxjs/toolkit": "^1.9.5",
    "react-redux": "^8.1.1",
    "redux-persist": "^6.0.0",
    "axios": "^1.4.0",
    "@react-native-async-storage/async-storage": "^1.19.0",
    "react-native-push-notification": "^8.1.1",
    "react-native-biometrics": "^3.0.1",
    "react-native-camera": "^4.2.1",
    "react-native-document-picker": "^9.0.1",
    "react-native-fs": "^2.20.0",
    "react-native-vector-icons": "^10.0.0",
    "react-native-gesture-handler": "^2.12.0",
    "react-native-reanimated": "^3.3.0",
    "react-native-safe-area-context": "^4.7.0",
    "react-native-screens": "^3.22.0",
    "react-native-svg": "^13.10.0",
    "react-native-charts-wrapper": "^0.5.11",
    "formik": "^2.4.2",
    "yup": "^1.2.0",
    "date-fns": "^2.30.0",
    "lodash": "^4.17.21",
    "i18next": "^23.2.11",
    "react-i18next": "^13.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.22.9",
    "@babel/preset-env": "^7.22.9",
    "@babel/runtime": "^7.22.6",
    "@react-native-community/eslint-config": "^3.2.0",
    "@testing-library/react-native": "^12.2.0",
    "@types/jest": "^29.5.3",
    "@types/react": "^18.2.15",
    "@types/react-native": "^0.72.2",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "babel-jest": "^29.6.1",
    "detox": "^20.10.2",
    "eslint": "^8.45.0",
    "jest": "^29.6.1",
    "metro-react-native-babel-preset": "^0.76.7",
    "prettier": "^3.0.0",
    "react-native-dotenv": "^3.4.9",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "jest": {
    "preset": "react-native",
    "setupFiles": ["./jest.setup.js"],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|@react-navigation)/)"
    ]
  }
}
