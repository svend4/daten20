    {
      "src": "/static/images/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/static/images/screenshot1.png",
      "sizes": "1280x720",
      "type": "image/png",
      "label": "Document List"
    },
    {
      "src": "/static/images/screenshot2.png",
      "sizes": "1280x720",
      "type": "image/png",
      "label": "Document Viewer"
    }
  ],
  "shortcuts": [
    {
      "name": "Upload Document",
      "short_name": "Upload",
      "description": "Upload a new document",
      "url": "/upload",
      "icons": [
        {
          "src": "/static/images/upload-icon.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Search Documents",
      "short_name": "Search",
      "description": "Search documents",
      "url": "/search",
      "icons": [
        {
          "src": "/static/images/search-icon.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "application/pdf",
            "application/msword",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "image/*",
            "text/*"
          ]
        }
      ]
    }
  },
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.dms.app",
      "id": "com.dms.app"
    },
    {
      "platform": "itunes",
      "url": "https://apps.apple.com/app/dms/id123456789"
    }
  ],
  "prefer_related_applications": false,
  "scope": "/",
  "serviceworker": {
    "src": "/service-worker.js",
    "scope": "/",
    "update_via_cache": "none"
  }
}
